# Every pin and option of the build. build.sh exports them (set -a) and passes them to the containers.
LO_VERSION=26.8.1.1
LO_COMMIT=bf6ef2662401c7d6dce671ab4deb26ee0af3a7c1
LO_SRC_URL=https://download.documentfoundation.org/libreoffice/src/26.8.1
LO_TARBALLS="libreoffice-26.8.1.1.tar.xz libreoffice-translations-26.8.1.1.tar.xz libreoffice-dictionaries-26.8.1.1.tar.xz"
# TDF "LibreOffice Build Team (CODE SIGNING KEY) <build@documentfoundation.org>"
LO_SIGNING_KEY=C2839ECAD9408FBE9531C3E9F434A1EFAFEEAEA3
EMSDK_VERSION=4.0.10
EMSDK_COMMIT=62a853cd3b3134398ce85cde8bb5cbb2ef0194cb
QT5_REPO=https://github.com/allotropia/qt5.git
QT5_COMMIT=3d440b7787f9b5ba15e5f8bcd7aef39b388f94fa
QTBASE_REPO=https://github.com/allotropia/qtbase.git
QTBASE_COMMIT=a320678c85ec8029d5394bcd673d4c208af1de3a
BASE_IMAGE=ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
LANGS="fr de es it"
WASM_MODULES="writer calc impress"
WITH_DICTS=0
# Our build number for the same LibreOffice version (label <LO_VERSION>-nl<BUILD_NUMBER>)
BUILD_NUMBER=2
MEM_LIMIT_GB=11
MAX_JOBS=6
# CPUs a build container may use (some bundled libraries start their own parallel sub-builds)
MAX_CPUS=6
MIN_FREE_DISK_GB=70
MIN_SWAP_GB=32
STOP_BELOW_DISK_GB=5
